# Copy this file to .env and fill in your values (.env is git-ignored)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789
# Seconds between request starts (each product is checked every CHECK_INTERVAL x number of products)
CHECK_INTERVAL=3
# Slowest pace the monitor backs off to after repeated blocks
MAX_CHECK_INTERVAL=8
REMIND_EVERY=300
# Optional: comma-separated sellers to ignore, e.g. IGNORE_SELLERS=Some Seller
IGNORE_SELLERS=
# Indian pincode Amazon uses for availability (Mumbai)
DELIVERY_PINCODE=400001
