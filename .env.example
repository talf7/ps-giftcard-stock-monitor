# Copy this file to .env and fill in your values (.env is git-ignored)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789
# Seconds between requests (each product is checked every CHECK_INTERVAL x number of products)
CHECK_INTERVAL=2
REMIND_EVERY=300
# Comma-separated sellers to ignore (their "in stock" fails at checkout)
IGNORE_SELLERS=Express Games
# Indian pincode Amazon uses for availability (Mumbai)
DELIVERY_PINCODE=400001
